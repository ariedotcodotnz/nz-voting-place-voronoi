# Copy to .env.local for local development, and set the same variables in
# Cloudflare Pages → Settings → Environment variables (Production and Preview).
# They are read at BUILD time and embedded in the static site, so the key is
# public: protect it with website restrictions (see README → Google Maps key).

# Required. Browser key with the Maps JavaScript API enabled.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. A Google Cloud Map ID (JavaScript, vector) enables vector rendering
# and cloud-based map styling. Leave empty to use the built-in muted raster style.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional. Microsoft Clarity project ID (Clarity → your project → Settings →
# Overview). Leave empty to turn analytics off, e.g. for local development and
# Cloudflare preview deployments.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
