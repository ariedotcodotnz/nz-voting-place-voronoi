{
  "name": "nz-voting-place-voronoi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "python3 -m http.server --directory out 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data": "sh scripts/data.sh build",
    "data:validate": "sh scripts/data.sh validate",
    "test:py": "sh -c '[ -x .venv/bin/python ] && exec .venv/bin/python -m pytest -q tests/python || exec python3 -m pytest -q tests/python'",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:py && npm run data:validate && npm run build",
    "videos": "node scripts/make-videos.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/extensions": "^9.4.1",
    "@deck.gl/google-maps": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@microsoft/clarity": "^1.0.2",
    "@vis.gl/react-google-maps": "^1.10.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "d3": "^7.9.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3": "^7.4.3",
    "@types/google.maps": "^3.66.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
