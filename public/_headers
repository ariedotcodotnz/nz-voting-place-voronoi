# Cloudflare Pages response headers (copied into out/ by `next build`).

# Election datasets: file names carry a content hash, so they never change.
/data/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# The manifest points at the current hashed files, so it must be revalidated.
/data/manifest.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
